{
	"name": "wp-rest-cli",
	"version": "0.1.0",
	"description": "A WP-CLI-style command line tool for talking to any WordPress site's REST API over HTTP",
	"author": "Spacedmonkey <spacedmonkey2@gmail.com>",
	"license": "MIT",
	"keywords": [
		"wordpress",
		"wp-cli",
		"rest-api",
		"cli",
		"wp-json"
	],
	"homepage": "https://github.com/spacedmonkey/wp-rest-cli#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spacedmonkey/wp-rest-cli.git"
	},
	"bugs": {
		"url": "https://github.com/spacedmonkey/wp-rest-cli/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"bin": {
		"wp-rest-cli": "./dist/cli.js"
	},
	"dependencies": {
		"@wordpress/url": "^4.54.0",
		"commander": "^15.0.0",
		"conf": "^15.1.0",
		"flat": "^6.0.1",
		"json-2-csv": "^5.5.9",
		"ora": "^9.4.1",
		"picocolors": "^1.1.1",
		"table": "^6.9.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@jest/globals": "^30.5.1",
		"@types/node": "^26.4.1",
		"@wordpress/eslint-plugin": "^25.10.0",
		"@wordpress/prettier-config": "^4.54.0",
		"@wordpress/scripts": "^34.2.0",
		"eslint-plugin-import": "^2.32.0",
		"execa": "^9.5.2",
		"jest": "^30.5.1",
		"prettier": "npm:wp-prettier@^3.0.3",
		"ts-jest": "^29.4.12",
		"tsup": "^8.3.5",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vitest": "^5.0.0"
	},
	"scripts": {
		"wp": "tsx src/cli.ts",
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "npm run test:unit && npm run test:integration",
		"test:unit": "NODE_OPTIONS=--experimental-vm-modules wp-scripts test-unit-js",
		"test:unit:watch": "NODE_OPTIONS=--experimental-vm-modules wp-scripts test-unit-js --watch",
		"test:integration": "vitest run",
		"test:integration:watch": "vitest",
		"test:watch": "npm run test:unit:watch",
		"typecheck": "tsc --noEmit",
		"lint": "wp-scripts lint-js",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format"
	}
}
