{
  "name": "wp-rest-cli",
  "version": "0.1.0",
  "description": "A WP-CLI-style command line tool for talking to any WordPress site's REST API over HTTP",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wp-rest-cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "wp": "tsx src/cli.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@wordpress/url": "^4.54.0",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "flat": "^6.0.1",
    "json-2-csv": "^5.5.9",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "table": "^6.9.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^9.5.2",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
